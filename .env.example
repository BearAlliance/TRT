# Shared local development configuration. Copy this file to .env.local.
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000
CMS_ALLOWED_ORIGINS=http://localhost:3000
CMS_USERNAME=inventory-admin
# Generate with: npm run cms:hash-password -- "choose-a-long-password"
CMS_PASSWORD_HASH=
# Use a long random value, for example: openssl rand -base64 32
CMS_SESSION_SECRET=
DATA_DIR=.data
