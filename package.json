{
  "name": "trt-bicycles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"npm run site:dev\" \"npm run cms:dev\"",
    "build": "next build",
    "start": "next start",
    "site:dev": "next dev --turbopack",
    "cms:dev": "tsx watch --env-file=.env.local src/cms/server.ts",
    "cms:build": "tsc --noEmit -p tsconfig.cms.json",
    "cms:start": "tsx src/cms/server.ts",
    "cms:hash-password": "tsx src/cms/hash-password.ts",
    "lint": "eslint .",
    "test": "npm run lint && npm run prettier:check && npm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "browserslist": "defaults, not ie <= 11",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,json,md}": "prettier --write"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15"
  }
}
